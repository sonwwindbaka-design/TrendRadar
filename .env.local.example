# Copy this file to .env.local, then fill in the values needed on the Mac mini.
# Keep values quoted when they contain semicolons, ampersands, or spaces.

# Feishu bot webhook. Multiple webhooks can be separated with semicolons.
FEISHU_WEBHOOK_URL=""

# Optional AI settings, if you use AI analysis/translation locally.
# AI_ANALYSIS_ENABLED=true
# AI_API_KEY=""
# AI_MODEL=""
# AI_API_BASE=""

# Optional remote storage settings.
# S3_BUCKET_NAME=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT_URL=""
# S3_REGION=""
